{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "Full Map",
        "CS"
      ],
      "default": "Full Map"
    },
    "team_type": {
      "type": "string",
      "enum": [
        "Solo",
        "Duo",
        "Squad"
      ],
      "default": "Solo"
    },
    "map": {
      "type": "string"
    },
    "entry_fee": {
      "type": "number",
      "default": 0
    },
    "prize_pool": {
      "type": "number",
      "default": 0
    },
    "per_kill": {
      "type": "number",
      "default": 0
    },
    "match_time": {
      "type": "string",
      "format": "date-time"
    },
    "total_slots": {
      "type": "number",
      "default": 48
    },
    "filled_slots": {
      "type": "number",
      "default": 0
    },
    "banner_url": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "room_password": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "live",
        "completed"
      ],
      "default": "upcoming"
    }
  },
  "required": [
    "title",
    "mode"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}