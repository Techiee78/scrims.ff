{
  "name": "Registration",
  "type": "object",
  "properties": {
    "tournament_id": {
      "type": "string"
    },
    "tournament_title": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "ff_ign": {
      "type": "string"
    },
    "ff_uid": {
      "type": "string"
    },
    "slot_number": {
      "type": "number"
    },
    "entry_fee": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "joined",
        "cancelled"
      ],
      "default": "joined"
    },
    "played": {
      "type": "boolean",
      "default": false
    },
    "placement": {
      "type": "number"
    },
    "kills": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tournament_id",
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}